@model Project.Models.CustomerDashboardViewModel

@{
    ViewData["Title"] = "My Dashboard";
}

<section class="container py-5">
    <h1>My Dashboard</h1>
    <p>Welcome, @Model.FullName.</p>

    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    <div class="row g-3 my-4">
        <div class="col-md-4">
            <div class="card card-body">
                <span>Total Orders</span>
                <h3>@Model.TotalOrders</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-body">
                <span>Pending Orders</span>
                <h3>@Model.PendingOrders</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-body">
                <span>Completed Orders</span>
                <h3>@Model.CompletedOrders</h3>
            </div>
        </div>
    </div>

    <h2 class="mb-3">Order History</h2>

    @if (Model.Orders.Count == 0)
    {
        <div class="alert alert-info">
            No orders yet. Browse the collection to get started.
        </div>
    }

    @foreach (var order in Model.Orders)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <h3>SH-@order.Id</h3>
                    <span class="badge bg-secondary align-self-start">
                        @order.Status
                    </span>
                </div>

                <p class="small text-muted">
                    @order.PlacedAt.ToString("dd MMM yyyy HH:mm") UTC
                </p>

                <ul>
                    @foreach (var item in order.Items)
                    {
                        <li>
                            @item.ProductName —
                            @item.Quantity × Rs. @item.UnitPrice.ToString("N2")
                        </li>
                    }
                </ul>

                <strong>Total: Rs. @order.Total.ToString("N2")</strong>

                @if (order.Status == "Pending")
                {
                    <p class="mt-2 mb-0">
                        Pay cash when collecting your order at the shop.
                    </p>
                }
            </div>
        </div>
    }
</section>