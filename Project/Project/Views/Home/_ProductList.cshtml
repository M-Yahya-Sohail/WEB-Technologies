@model List<Project.Models.Product>

<div class="row g-4">
    @foreach (var product in Model)
    {
        <div class="col-sm-6 col-lg-3">
            <article class="product-card h-100 overflow-hidden">
                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                {
                    <img class="w-100 object-fit-cover"
                         style="height:190px"
                         src="@product.ImageUrl"
                         alt="@(string.IsNullOrWhiteSpace(product.ImageAlt)
                                                 ? product.Name : product.ImageAlt)"
                         loading="lazy" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light"
                         style="height:190px">
                        <span class="text-muted">No image available</span>
                    </div>
                }

                <div class="p-3">
                    <p class="eyebrow">@product.Category</p>

                    <h3>@product.Name</h3>

                    <p class="small muted">@product.Description</p>

                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <strong>Rs. @product.Price.ToString("N2")</strong>

                        <span class="stock">
                            @(product.Stock > 0 ? "In stock" : "Out of stock")
                        </span>
                    </div>

                    @if (product.Stock > 0)
                    {
                        <form asp-area=""
                              asp-controller="Cart"
                              asp-action="Add"
                              method="post"
                              class="mt-3">

                            <input type="hidden"
                                   name="productId"
                                   value="@product.Id" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Add to Cart
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-secondary w-100 mt-3"
                                disabled>
                            Out of Stock
                        </button>
                    }
                </div>
            </article>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info mt-3">
        No products match your search.
    </div>
}