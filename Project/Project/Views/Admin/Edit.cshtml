@model Project.Models.ProductFormViewModel

@{
	ViewData["Title"] = Model.Id == 0 ? "Add Product" : "Edit Product";
}

<section class="container py-5">
	<div class="mx-auto" style="max-width: 700px;">
		<h1 class="mb-4">@ViewData["Title"]</h1>

		<form asp-controller="Admin" asp-action="Save" method="post">
			<input asp-for="Id" type="hidden" />

			<div asp-validation-summary="All"
				 class="text-danger mb-3"></div>

			<div class="mb-3">
				<label asp-for="Name" class="form-label"></label>
				<input asp-for="Name" class="form-control" />
			</div>

			<div class="mb-3">
				<label asp-for="Category" class="form-label"></label>
				<select asp-for="Category" class="form-select">
					<option value="">Select category</option>
					<option value="Notebooks">Notebooks</option>
					<option value="Pens">Pens</option>
					<option value="Books">Books</option>
					<option value="Desk Essentials">Desk Essentials</option>
				</select>
			</div>

			<div class="mb-3">
				<label asp-for="Description" class="form-label"></label>
				<textarea asp-for="Description"
						  class="form-control" rows="3"></textarea>
			</div>

			<div class="row">
				<div class="col-md-6 mb-3">
					<label asp-for="Price" class="form-label"></label>
					<input asp-for="Price" type="number"
						   step="0.01" min="0.01" class="form-control" />
				</div>

				<div class="col-md-6 mb-3">
					<label asp-for="Stock" class="form-label"></label>
					<input asp-for="Stock" type="number"
						   min="0" class="form-control" />
				</div>
			</div>

			<div class="mb-3">
				<label asp-for="ImageUrl" class="form-label">
					Image URL (optional)
				</label>
				<input asp-for="ImageUrl" type="url"
					   class="form-control"
					   placeholder="https://example.com/product.jpg" />
			</div>

			<div class="mb-3">
				<label asp-for="ImageAlt" class="form-label">
					Image description (optional)
				</label>
				<input asp-for="ImageAlt" class="form-control" />
			</div>

			<div class="form-check mb-4">
				<input asp-for="IsActive" class="form-check-input" />
				<label asp-for="IsActive" class="form-check-label">
					Active — visible in catalogue
				</label>
			</div>

			<button type="submit" class="btn btn-primary">
				Save Product
			</button>

			<a asp-action="Index" class="btn btn-outline-secondary">
				Cancel
			</a>
		</form>
	</div>
</section>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}