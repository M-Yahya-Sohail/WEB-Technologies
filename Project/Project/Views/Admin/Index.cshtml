@model Project.Models.AdminDashboardViewModel

@{
	ViewData["Title"] = "Admin Dashboard";
}

<section class="container py-5">
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
		<h1>Admin Dashboard</h1>

		<a asp-controller="Admin"
		   asp-action="Create"
		   class="btn btn-primary">
			Add Product
		</a>
	</div>

	@if (TempData["Message"] is string message)
	{
		<div class="alert alert-success">@message</div>
	}

	<div class="row g-3 mb-4">
		<div class="col-md-4">
			<div class="card card-body h-100">
				<span>Total Products</span>
				<h3>@Model.Products.Count</h3>
			</div>
		</div>

		<div class="col-md-4">
			<div class="card card-body h-100">
				<span>Active Products</span>
				<h3>@Model.Products.Count(p => p.IsActive)</h3>
			</div>
		</div>

		<div class="col-md-4">
			<div class="card card-body h-100">
				<span>Low Stock — 5 or fewer</span>
				<h3>@Model.LowStockProducts</h3>
			</div>
		</div>
	</div>

	<h2 class="mb-3">Products</h2>

	@if (Model.Products.Count == 0)
	{
		<div class="alert alert-info">
			No products yet. Click Add Product to create your first product.
		</div>
	}
	else
	{
		<div class="table-responsive">
			<table class="table table-striped align-middle">
				<thead>
					<tr>
						<th scope="col">Name</th>
						<th scope="col">Category</th>
						<th scope="col">Price</th>
						<th scope="col">Stock</th>
						<th scope="col">Status</th>
						<th scope="col">Actions</th>
					</tr>
				</thead>

				<tbody>
					@foreach (var product in Model.Products)
					{
						<tr>
							<td>@product.Name</td>
							<td>@product.Category</td>
							<td>Rs. @product.Price.ToString("N2")</td>
							<td>@product.Stock</td>

							<td>
								@(product.IsActive ? "Active" : "Archived")
							</td>

							<td>
								<a asp-controller="Admin"
								   asp-action="Edit"
								   asp-route-id="@product.Id"
								   class="btn btn-sm btn-outline-primary">
									Edit
								</a>

								@if (product.IsActive)
								{
									<form asp-controller="Admin"
										  asp-action="Archive"
										  method="post"
										  class="d-inline">

										<input type="hidden"
											   name="id"
											   value="@product.Id" />

										<button class="btn btn-sm btn-outline-danger"
												type="submit">
											Archive
										</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}

	<hr class="my-5" />

	<h2 class="mb-4">Customer Orders</h2>

	<div class="row g-3 mb-4">
		<div class="col-md-6">
			<div class="card card-body">
				<span>Pending Orders</span>
				<h3>@Model.PendingOrders</h3>
			</div>
		</div>

		<div class="col-md-6">
			<div class="card card-body">
				<span>Completed Orders</span>
				<h3>@Model.CompletedOrders</h3>
			</div>
		</div>
	</div>

	@if (Model.Orders.Count == 0)
	{
		<div class="alert alert-info">
			No customer orders yet.
		</div>
	}

	@foreach (var order in Model.Orders)
	{
		<div class="card mb-3">
			<div class="card-body">
				<div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
					<div>
						<h3>SH-@order.Id</h3>
						<p class="mb-1">@order.CustomerName</p>

						<p class="small text-muted">
							@order.PlacedAt.ToString("dd MMM yyyy HH:mm") UTC
						</p>
					</div>

					<span class="badge @(order.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
						@order.Status
					</span>
				</div>

				<ul class="mb-3">
					@foreach (var item in order.Items)
					{
						<li>
							@item.ProductName —
							@item.Quantity × Rs. @item.UnitPrice.ToString("N2")
						</li>
					}
				</ul>

				<p>
					<strong>
						Total: Rs. @order.Total.ToString("N2")
					</strong>
				</p>

				@if (order.Status == "Pending")
				{
					<form asp-controller="Admin"
						  asp-action="Complete"
						  method="post">

						<input type="hidden"
							   name="id"
							   value="@order.Id" />

						<button type="submit" class="btn btn-primary">
							Confirm Paid &amp; Collected
						</button>
					</form>
				}
				else if (order.Status == "Completed")
				{
					<p class="text-success mb-0">
						Payment and collection confirmed.
					</p>
				}
			</div>
		</div>
	}
</section>