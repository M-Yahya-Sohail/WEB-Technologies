@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin dashboard"; }
<section class="container section-space">
    <div class="dashboard-heading"><div><p class="eyebrow">SHOP WORKSPACE / ADMIN</p><h1>A good day to get organised<span class="text-success">.</span></h1><p class="muted">An overview of your shop, stock and pickup orders.</p></div>
        <span class="workspace-badge">SHOPKEEPER WORKSPACE</span>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3"><div class="metric"><span>Products</span><strong>@Model.Products.Count</strong><small class="muted">Across @Model.Products.Select(p => p.Category).Distinct().Count() categories</small></div></div>
        <div class="col-sm-6 col-lg-3"><div class="metric"><span>Pending orders</span><strong>@Model.PendingOrders.ToString("00")</strong><small class="muted">Awaiting payment &amp; pickup (sample)</small></div></div>
        <div class="col-sm-6 col-lg-3"><div class="metric"><span>Completed orders</span><strong>@Model.CompletedOrders.ToString("00")</strong><small class="muted">Paid and collected (sample)</small></div></div>
        <div class="col-sm-6 col-lg-3"><div class="metric"><span>Low-stock products</span><strong>@Model.LowStockProducts.ToString("00")</strong><small class="muted">Time to check your shelves</small></div></div>
    </div>
    <div class="surface mb-4"><div class="d-flex justify-content-between align-items-center mb-3"><h2>Pending pickup orders</h2><span class="badge text-bg-warning">@Model.PendingOrders orders</span></div>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Order</th><th>Customer</th><th>Placed on</th><th>Total</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var order in Model.SampleOrders.Where(o => o.Status == "Pending"))
            {
                <tr><td><strong>#@order.Number</strong></td><td>@order.CustomerName</td><td>@order.Date.ToString("dd MMM yyyy")</td><td>Rs. @order.Total.ToString("N0")</td><td><span class="badge text-bg-warning">@order.Status</span></td></tr>
            }
            </tbody>
        </table></div>
    </div>
    <div class="row g-4"><div class="col-lg-7"><div class="surface h-100"><div class="d-flex justify-content-between align-items-center"><h2>Stock watch</h2><span class="small muted">Sample inventory</span></div>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Product</th><th>Category</th><th>Remaining</th></tr></thead>
            <tbody>
                @foreach (var product in Model.Products.Where(p => p.Stock <= 5))
                {
                    <tr><td>@product.Name</td><td>@product.Category</td><td><span class="badge text-bg-warning">@product.Stock units</span></td></tr>
                }
            </tbody>
        </table></div>
    </div></div>
    <div class="col-lg-5"><div class="pickup-panel h-100"><p class="eyebrow">SHOP MANAGEMENT</p><h2>Keep your shop running smoothly.</h2>
        <p class="small">Stay on top of your daily operations with a clear overview of orders, products and inventory.</p>
        <p class="small">Product editing, checkout and stock updates are scheduled for Deliverable 3.</p>
        <a class="text-link" asp-controller="Home" asp-action="Index">View storefront ↗</a>
    </div></div></div>
</section>
