@model BSEF24A020_LAB5.ViewModels.HomeViewModel

@{
	ViewData["Title"] = "Home";
}

<h2 class="text-center mb-4">Book Store</h2>

<div class="row">

	<div class="col-md-6">
		<h3>Add Book</h3>

		<form method="post" action="/Home/AddBook">

			<div class="mb-3">
				<label>Book Title</label>
				<input type="text" name="title" class="form-control" required />
			</div>

			<div class="mb-3">
				<label>Price</label>
				<input type="number" name="price" class="form-control" min="0" step="0.01" required />
			</div>

			<div class="mb-3">
				<label>Author</label>

				<select name="authorId" class="form-select">
					@foreach (var author in Model.Authors)
					{
						<option value="@author.Id">
							@author.Name
						</option>
					}
				</select>
			</div>

			<button type="submit" class="btn btn-primary">
				Add Book
			</button>

		</form>
	</div>

	<div class="col-md-6">
		<h3>Add Author</h3>

		<form method="post" action="/Home/AddAuthor">

			<div class="mb-3">
				<label>Author Name</label>
				<input type="text" name="name" class="form-control" required />
			</div>

			<div class="mb-3">
				<label>Country</label>
				<input type="text" name="country" class="form-control" required />
			</div>

			<button type="submit" class="btn btn-success">
				Add Author
			</button>

		</form>
	</div>

</div>

<hr />

<h3>Available Books</h3>

@if (Model.Books.Count == 0)
{
	<p>No books available</p>
}
else
{
	<div class="d-flex flex-wrap">

		@foreach (var book in Model.Books)
		{
			<div class="book-card">

				<h4>@book.Title</h4>

				<p>Author: @book.AuthorName</p>

				<p>Price: Rs. @book.Price</p>

				<form method="post" action="/Home/RemoveBook" onsubmit="return confirmRemove();">
					<input type="hidden" name="id" value="@book.Id" />

					<button type="submit" class="btn btn-danger">
						Remove
					</button>
				</form>

			</div>
		}

	</div>
}

@section Styles {
	<style>
		.book-card {
			border: 2px solid black;
			padding: 15px;
			margin: 10px;
			width: 250px;
			border-radius: 8px;
		}
	</style>
}

@section Scripts {
	<script>
		function confirmRemove() {
			return confirm("Remove this book?");
		}
	</script>
}